# ── Server ──────────────────────────────────────────────────────────────────
APP_NAME=Codebase to Markdown
HOST=0.0.0.0
PORT=8080

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Limits ──────────────────────────────────────────────────────────────────
MAX_ARCHIVE_MB=200          # Largest upload accepted
MAX_EXTRACTED_MB=600        # Largest expanded size (stops zip bombs)
MAX_FILES=8000              # Hard cap on files scanned per job
MAX_FILE_KB_DEFAULT=400     # Default per-file inline limit
MAX_FILE_KB_CEILING=4096    # Highest value a request may ask for

# ── Jobs ────────────────────────────────────────────────────────────────────
JOB_TTL_SECONDS=3600        # Results are dropped after this long
MAX_JOBS=64                 # Oldest jobs evicted past this count

# ── Sources ─────────────────────────────────────────────────────────────────
# Reading a server-side directory is convenient locally and risky in
# production. Turn it off when deploying, or pin it to specific roots.
ALLOW_LOCAL_PATH=true
LOCAL_PATH_ROOTS=

ALLOW_REMOTE_FETCH=true
REMOTE_TIMEOUT_SECONDS=60
# Optional — raises the GitHub rate limit and allows private repos.
GITHUB_TOKEN=
